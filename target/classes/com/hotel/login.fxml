<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.VBox?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/21" 
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.hotel.controller.LoginController" 
      spacing="15" 
      alignment="CENTER" 
      prefWidth="350" 
      prefHeight="250">
    
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="Gestion Hôtelière - Connexion" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
    
    <TextField fx:id="emailField" promptText="Identifiant (Email)"/>
    
    <PasswordField fx:id="passwordField" promptText="Mot de passe"/>
    
    <Button text="Se connecter" onAction="#handleLogin" 
            style="-fx-background-color: #2196F3; -fx-text-fill: white;"
            maxWidth="Infinity"/>

</VBox>