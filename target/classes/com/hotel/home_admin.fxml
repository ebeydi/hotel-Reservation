<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane prefHeight="700.0" prefWidth="1100.0" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.hotel.controller.HomeAdminController">
   
   <left>
      <VBox prefWidth="260.0" spacing="10.0" style="-fx-background-color: #1a252f;">
         <children>
            <Label text="PANNEAU ADMIN" textFill="#f1c40f">
               <font><Font name="System Bold" size="22.0" /></font>
               <VBox.margin><Insets bottom="40.0" top="10.0" /></VBox.margin>
            </Label>
            
            <Button onAction="#showDashboard" alignment="BASELINE_LEFT" maxWidth="Infinity" prefHeight="50.0" style="-fx-background-color: #2c3e50; -fx-text-fill: white; -fx-cursor: hand;" text="📊   Tableau de Bord" />
            
            <Button onAction="#showStaffManagement" alignment="BASELINE_LEFT" maxWidth="Infinity" prefHeight="50.0" style="-fx-background-color: transparent; -fx-text-fill: #ecf0f1; -fx-cursor: hand;" text="👥   Gestion Personnel" />
            
            <Button onAction="#showRoomManagement" alignment="BASELINE_LEFT" maxWidth="Infinity" prefHeight="50.0" style="-fx-background-color: transparent; -fx-text-fill: #ecf0f1; -fx-cursor: hand;" text="🏨   Configuration Chambres" />
            
            <Button onAction="#showHotelProfil" alignment="BASELINE_LEFT" maxWidth="Infinity" prefHeight="50.0" style="-fx-background-color: transparent; -fx-text-fill: #ecf0f1; -fx-cursor: hand;" text="⚙️   Paramètres Hôtel" />
            
            <Region VBox.vgrow="ALWAYS" />
            
            <Button onAction="#handleLogout" alignment="BASELINE_LEFT" maxWidth="Infinity" prefHeight="50.0" style="-fx-background-color: transparent; -fx-text-fill: #e74c3c; -fx-cursor: hand;" text="🚪   Déconnexion" />
         </children>
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
         </padding>
      </VBox>
   </left>

   <center>
      <StackPane fx:id="contentArea" style="-fx-background-color: #ecf0f1;">
         <children>
            <VBox fx:id="dashboardView" spacing="30.0">
               <children>
                  <Label text="Statistiques Globales" textFill="#2c3e50">
                     <font><Font name="System Bold" size="28.0" /></font>
                  </Label>
                  
                  <HBox spacing="20.0">
                     <children>
                        <VBox prefHeight="150.0" prefWidth="250.0" style="-fx-background-color: white; -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5);">
                           <children>
                              <Label text="Chiffre d'Affaire (Mois)" textFill="#95a5a6" />
                              <Label text="4.5M FCFA" textFill="#27ae60">
                                 <font><Font name="System Bold" size="32.0" /></font>
                              </Label>
                           </children>
                           <padding>
                              <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                           </padding>
                        </VBox>
                        
                        <VBox prefHeight="150.0" prefWidth="250.0" style="-fx-background-color: white; -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5);">
                           <children>
                              <Label text="Réceptionnistes Actifs" textFill="#95a5a6" />
                              <Label text="04" textFill="#2980b9">
                                 <font><Font name="System Bold" size="32.0" /></font>
                              </Label>
                           </children>
                           <padding>
                              <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                           </padding>
                        </VBox>
                     </children>
                  </HBox>
               </children>
               <padding>
                  <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
               </padding>
            </VBox>
         </children>
      </StackPane>
   </center>
</BorderPane>