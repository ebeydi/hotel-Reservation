<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox spacing="20.0" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.hotel.controller.ManageStaffController">
    <children>
        <Label text="👤 GESTION DU PERSONNEL" textFill="#2c3e50">
            <font><Font name="System Bold" size="24.0" /></font>
        </Label>
        
        <HBox alignment="CENTER_RIGHT" spacing="10.0">
            <children>
                <Button onAction="#handleAddNewStaff" 
                        style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" 
                        text="+ Nouveau" />
                
                <Button onAction="#handleEditStaff" 
                        style="-fx-background-color: #f39c12; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" 
                        text="📝 Modifier" />
                
                <Button onAction="#handleDeleteStaff" 
                        style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" 
                        text="🗑️ Supprimer" />
            </children>
        </HBox>

        <TableView fx:id="staffTable" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colNom" prefWidth="150.0" text="Nom" />
                <TableColumn fx:id="colPrenom" prefWidth="150.0" text="Prénom" />
                <TableColumn fx:id="colEmail" prefWidth="250.0" text="Email" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>
    </children>
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
</VBox>