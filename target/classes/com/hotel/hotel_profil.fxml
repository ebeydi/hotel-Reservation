<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="20" style="-fx-background-color: white;" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.hotel.controller.HotelProfilController">
    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
    
    <Label text="PARAMÈTRES DE L'ÉTABLISSEMENT" style="-fx-font-size: 20; -fx-font-weight: bold;"/>
    
    <GridPane hgap="10" vgap="10">
        <Label text="Nom de l'hôtel :" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <TextField fx:id="txtNom" GridPane.columnIndex="1" GridPane.rowIndex="0" prefWidth="300"/>
        
        <Label text="Ville :" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
        <TextField fx:id="txtVille" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
        
        <Label text="Adresse :" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
        <TextField fx:id="txtAdresse" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

        <Label text="Téléphone :" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
        <TextField fx:id="txtTelephone" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
        
        <Label text="Email :" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
        <TextField fx:id="txtEmail" GridPane.columnIndex="1" GridPane.rowIndex="4"/>
        
        <Label text="Description :" GridPane.columnIndex="0" GridPane.rowIndex="5"/>
        <TextArea fx:id="txtDescription" GridPane.columnIndex="1" GridPane.rowIndex="5" prefHeight="100"/>
    </GridPane>
    
    <Button text="Enregistrer les modifications" onAction="#handleUpdateHotel" 
            style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-font-weight: bold;"/>
</VBox>