<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="850.0" prefWidth="1300.0" style="-fx-background-color: #f1f5f9;" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.hotel.controller.HomeClientController">
    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="80.0" spacing="20.0" style="-fx-background-color: #0f172a;">
            <padding><Insets left="20.0" /></padding>
            <Button onAction="#toggleMenu" style="-fx-background-color: transparent; -fx-font-size: 26; -fx-cursor: hand;" text="☰" textFill="WHITE" />
            <Label style="-fx-font-weight: bold; -fx-font-size: 20;" text="LA PETITE COTE" textFill="WHITE" />
        </HBox>
    </top>

    <center>
        <StackPane alignment="TOP_LEFT">
            <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;">
                <VBox spacing="30.0">
                    <padding><Insets bottom="40.0" left="40.0" right="40.0" top="40.0" /></padding>

                    <VBox alignment="CENTER" prefHeight="150.0" spacing="10" style="-fx-background-color: #1e293b; -fx-background-radius: 25;">

                        <Label fx:id="lblCustomerName"
                               style="-fx-font-size: 32; -fx-font-weight: bold;"
                               text="BIENVENUE" /> <Label fx:id="lblSlogan"
                                                          style="-fx-font-size: 16;"
                                                          text="Tomber amoureux de la Petite Côte" />

                    </VBox>

                    <VBox fx:id="viewLocalities" spacing="30.0">
                        <Label style="-fx-font-size: 28; -fx-font-weight: bold; -fx-text-fill: #0f172a;" text="🌍 NOS DESTINATIONS" />
                        <FlowPane alignment="CENTER" hgap="30.0" vgap="30.0">
                            <StackPane onMouseClicked="#clickSaly" style="-fx-cursor: hand;">
                                <ImageView fitHeight="200.0" fitWidth="300.0" pickOnBounds="true"><Image url="@images/saly.jpg" /></ImageView>
                                <Pane style="-fx-background-color: rgba(0,0,0,0.4); -fx-background-radius: 15;" />
                                <Label style="-fx-font-size: 20; -fx-font-weight: bold;" text="SALY" textFill="WHITE" />
                            </StackPane>

                            <StackPane onMouseClicked="#clickSomone" style="-fx-cursor: hand;">
                                <ImageView fitHeight="200.0" fitWidth="300.0" pickOnBounds="true"><Image url="@images/somone.jpg" /></ImageView>
                                <Pane style="-fx-background-color: rgba(0,0,0,0.4); -fx-background-radius: 15;" />
                                <Label style="-fx-font-size: 20; -fx-font-weight: bold;" text="LA SOMONE" textFill="WHITE" />
                            </StackPane>

                            <StackPane onMouseClicked="#clickNgaparou" style="-fx-cursor: hand;">
                                <ImageView fitHeight="200.0" fitWidth="300.0" pickOnBounds="true"><Image url="@images/ngaparou.jpg" /></ImageView>
                                <Pane style="-fx-background-color: rgba(0,0,0,0.4); -fx-background-radius: 15;" />
                                <Label style="-fx-font-size: 20; -fx-font-weight: bold;" text="NGAPAROU" textFill="WHITE" />
                            </StackPane>

                            <StackPane onMouseClicked="#clickPalmarin" style="-fx-cursor: hand;">
                                <ImageView fitHeight="200.0" fitWidth="300.0" pickOnBounds="true"><Image url="@images/palmarin.jpg" /></ImageView>
                                <Pane style="-fx-background-color: rgba(0,0,0,0.4); -fx-background-radius: 15;" />
                                <Label style="-fx-font-size: 20; -fx-font-weight: bold;" text="PALMARIN" textFill="WHITE" />
                            </StackPane>

                            <StackPane onMouseClicked="#clickPopenguine" style="-fx-cursor: hand;">
                                <ImageView fitHeight="200.0" fitWidth="300.0" pickOnBounds="true"><Image url="@images/popenguine.jpg" /></ImageView>
                                <Pane style="-fx-background-color: rgba(0,0,0,0.4); -fx-background-radius: 15;" />
                                <Label style="-fx-font-size: 20; -fx-font-weight: bold;" text="POPENGUINE" textFill="WHITE" />
                            </StackPane>

                            <StackPane onMouseClicked="#clickToubab" style="-fx-cursor: hand;">
                                <ImageView fitHeight="200.0" fitWidth="300.0" pickOnBounds="true"><Image url="@images/dialao.jpg" /></ImageView>
                                <Pane style="-fx-background-color: rgba(0,0,0,0.4); -fx-background-radius: 15;" />
                                <Label style="-fx-font-size: 20; -fx-font-weight: bold;" text="TOUBAB DIALAO" textFill="WHITE" />
                            </StackPane>

                            <StackPane onMouseClicked="#clickNianing" style="-fx-cursor: hand;">
                                <ImageView fitHeight="200.0" fitWidth="300.0" pickOnBounds="true"><Image url="@images/nianing.jpg" /></ImageView>
                                <Pane style="-fx-background-color: rgba(0,0,0,0.4); -fx-background-radius: 15;" />
                                <Label style="-fx-font-size: 20; -fx-font-weight: bold;" text="NIANING" textFill="WHITE" />
                            </StackPane>

                            <StackPane onMouseClicked="#clickMbodjene" style="-fx-cursor: hand;">
                                <ImageView fitHeight="200.0" fitWidth="300.0" pickOnBounds="true"><Image url="@images/mbodjene.jpg" /></ImageView>
                                <Pane style="-fx-background-color: rgba(0,0,0,0.4); -fx-background-radius: 15;" />
                                <Label style="-fx-font-size: 20; -fx-font-weight: bold;" text="MBODJÈNE" textFill="WHITE" />
                            </StackPane>

                            <StackPane onMouseClicked="#clickWarang" style="-fx-cursor: hand;">
                                <ImageView fitHeight="200.0" fitWidth="300.0" pickOnBounds="true"><Image url="@images/warang.jpg" /></ImageView>
                                <Pane style="-fx-background-color: rgba(0,0,0,0.4); -fx-background-radius: 15;" />
                                <Label style="-fx-font-size: 20; -fx-font-weight: bold;" text="WARANG" textFill="WHITE" />
                            </StackPane>

                            <StackPane onMouseClicked="#clickJoal" style="-fx-cursor: hand;">
                                <ImageView fitHeight="200.0" fitWidth="300.0" pickOnBounds="true"><Image url="@images/joal.jpg" /></ImageView>
                                <Pane style="-fx-background-color: rgba(0,0,0,0.4); -fx-background-radius: 15;" />
                                <Label style="-fx-font-size: 20; -fx-font-weight: bold;" text="JOAL" textFill="WHITE" />
                            </StackPane>
                        </FlowPane>
                    </VBox>

                    <VBox fx:id="viewHotels" managed="false" spacing="25.0" visible="false">
                        <Button onAction="#showLocalities" style="-fx-background-color: #0f172a; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="← RETOUR AUX DESTINATIONS" />
                        <VBox fx:id="containerHotels" spacing="30.0" />
                    </VBox>

                    <VBox fx:id="viewReservations" managed="false" spacing="25.0" visible="false">
                        <Label style="-fx-font-size: 28; -fx-font-weight: bold; -fx-text-fill: #0f172a;" text="📂 VOS RÉSERVATIONS" />
                        <VBox fx:id="containerReservations" spacing="20.0" />
                    </VBox>
                </VBox>
            </ScrollPane>

            <VBox fx:id="sideMenu" maxWidth="300.0" prefWidth="300.0" style="-fx-background-color: #020617;" translateX="-300.0">
                <padding><Insets top="40" /></padding>
                <Label style="-fx-font-size: 26; -fx-font-weight: bold; -fx-padding: 20;" text="NAVIGATION" textFill="#f1c40f" />
                <Button maxWidth="Infinity" onAction="#showLocalities" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-alignment: CENTER_LEFT; -fx-padding: 20 40; -fx-font-size: 16; -fx-cursor: hand;" text="🏠 ACCUEIL" />
                <Button maxWidth="Infinity" onAction="#showReservations" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-alignment: CENTER_LEFT; -fx-padding: 20 40; -fx-font-size: 16; -fx-cursor: hand;" text="📅 MES RÉSERVATIONS" />
                <Button maxWidth="Infinity" onAction="#handleLogout" style="-fx-background-color: transparent; -fx-text-fill: #ef4444; -fx-alignment: CENTER_LEFT; -fx-padding: 20 40; -fx-font-size: 16; -fx-cursor: hand; -fx-font-weight: bold;" text="🚪 DÉCONNEXION" />
                <Region VBox.vgrow="ALWAYS" />
                <Label style="-fx-padding: 20; -fx-text-fill: #475569;" text="Version 2.0 - Premium" />
            </VBox>
        </StackPane>
    </center>
</BorderPane>