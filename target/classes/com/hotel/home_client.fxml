<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane prefHeight="700.0" prefWidth="1000.0" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.hotel.controller.HomeClientController">
   
   <left>
      <VBox prefWidth="240.0" spacing="15.0" style="-fx-background-color: #2c3e50;">
         <children>
            <Label text="LA PETITE CÔTE" textFill="#e67e22">
               <font><Font name="System Bold" size="20.0" /></font>
               <VBox.margin>
                  <Insets bottom="30.0" top="10.0" />
               </VBox.margin>
            </Label>
            
            <Button alignment="BASELINE_LEFT" maxWidth="Infinity" prefHeight="45.0" style="-fx-background-color: #34495e; -fx-text-fill: white;" text="🏠   Accueil" />
            <Button alignment="BASELINE_LEFT" maxWidth="Infinity" prefHeight="45.0" style="-fx-background-color: transparent; -fx-text-fill: #ecf0f1;" text="🏨   Réserver" />
            <Button alignment="BASELINE_LEFT" maxWidth="Infinity" prefHeight="45.0" style="-fx-background-color: transparent; -fx-text-fill: #ecf0f1;" text="📅   Mes Réservations" />
            
            <Region VBox.vgrow="ALWAYS" />
            
            <Button onAction="#handleLogout" alignment="BASELINE_LEFT" maxWidth="Infinity" prefHeight="45.0" style="-fx-background-color: transparent; -fx-text-fill: #e74c3c;" text="🚪   Déconnexion" />
         </children>
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
         </padding>
      </VBox>
   </left>

   <center>
      <VBox spacing="30.0" style="-fx-background-color: #f5f6fa;">
         <children>
            <HBox alignment="CENTER_LEFT">
               <children>
                  <VBox>
                     <children>
                        <Label fx:id="lblWelcome" text="Bienvenue, Client !" textFill="#2c3e50">
                           <font><Font name="System Bold" size="32.0" /></font>
                        </Label>
                        <Label fx:id="lblEmail" text="client@email.com" textFill="#7f8c8d" />
                     </children>
                  </VBox>
               </children>
            </HBox>

            <HBox spacing="20.0">
               <children>
                  <VBox prefHeight="120.0" prefWidth="250.0" style="-fx-background-color: white; -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5);">
                     <children>
                        <Label text="Séjours passés" textFill="#95a5a6" />
                        <Label text="12" textFill="#2c3e50">
                           <font><Font name="System Bold" size="36.0" /></font>
                        </Label>
                     </children>
                     <padding>
                        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                     </padding>
                  </VBox>
                  
                  <VBox prefHeight="120.0" prefWidth="250.0" style="-fx-background-color: white; -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5);">
                     <children>
                        <Label text="Points Fidélité" textFill="#95a5a6" />
                        <Label text="1,250" textFill="#e67e22">
                           <font><Font name="System Bold" size="36.0" /></font>
                        </Label>
                     </children>
                     <padding>
                        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                     </padding>
                  </VBox>
               </children>
            </HBox>
         </children>
         <padding>
            <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
         </padding>
      </VBox>
   </center>
</BorderPane>