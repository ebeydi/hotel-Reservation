<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.*?>

<ScrollPane fitToWidth="true" style="-fx-background-color: #f8f9fa;" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.hotel.controller.AdminDashboardController">
   <content>
      <VBox spacing="30.0" style="-fx-background-color: #f8f9fa;">
         <children>
            <Label text="Tableau de Bord Administrateur" textFill="#2c3e50">
               <font><Font name="System Bold" size="28.0" /></font>
            </Label>
            
            <FlowPane hgap="20.0" vgap="20.0">
               <children>
                  <VBox prefHeight="120.0" prefWidth="220.0" style="-fx-background-color: white; -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 5);">
                     <padding><Insets bottom="20.0" left="20.0" right="20.0" top="20.0" /></padding>
                     <children>
                        <Label text="Chiffre d'Affaire" textFill="#95a5a6">
                           <font><Font size="14.0" /></font>
                        </Label>
                        <Label fx:id="lblRevenue" text="0 FCFA" textFill="#27ae60">
                           <font><Font name="System Bold" size="26.0" /></font>
                        </Label>
                     </children>
                  </VBox>

                  <VBox prefHeight="120.0" prefWidth="220.0" style="-fx-background-color: white; -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 5);">
                     <padding><Insets bottom="20.0" left="20.0" right="20.0" top="20.0" /></padding>
                     <children>
                        <Label text="Occupation" textFill="#95a5a6">
                           <font><Font size="14.0" /></font>
                        </Label>
                        <Label fx:id="lblOccupation" text="0%" textFill="#2980b9">
                           <font><Font name="System Bold" size="26.0" /></font>
                        </Label>
                     </children>
                  </VBox>

                  <VBox prefHeight="120.0" prefWidth="220.0" style="-fx-background-color: white; -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 5);">
                     <padding><Insets bottom="20.0" left="20.0" right="20.0" top="20.0" /></padding>
                     <children>
                        <Label text="Réceptionnistes" textFill="#95a5a6">
                           <font><Font size="14.0" /></font>
                        </Label>
                        <Label fx:id="lblStaffCount" text="0" textFill="#8e44ad">
                           <font><Font name="System Bold" size="26.0" /></font>
                        </Label>
                     </children>
                  </VBox>
               </children>
            </FlowPane>

            <VBox spacing="10.0" style="-fx-background-color: white; -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 5);">
               <padding><Insets bottom="20.0" left="20.0" right="20.0" top="20.0" /></padding>
               <children>
                  <Label text="Performance Mensuelle" textFill="#2c3e50">
                     <font><Font name="System Bold" size="18.0" /></font>
                  </Label>
                  <AreaChart fx:id="revenueChart" prefHeight="300.0" createSymbols="false">
                    <xAxis><CategoryAxis side="BOTTOM" /></xAxis>
                    <yAxis><NumberAxis side="LEFT" /></yAxis>
                  </AreaChart>
               </children>
            </VBox>
         </children>
         <padding><Insets bottom="30.0" left="30.0" right="30.0" top="30.0" /></padding>
      </VBox>
   </content>
</ScrollPane>