<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="700.0" prefWidth="950.0" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.hotel.controller.AuthController">
   <children>
      <ImageView fitHeight="700.0" fitWidth="950.0" pickOnBounds="true" preserveRatio="false">
         <image>
            <Image url="@images/petitecote2.jpg" />
         </image>
      </ImageView>

      <VBox alignment="CENTER" layoutX="530.0" layoutY="50.0" prefWidth="380.0" spacing="15.0" 
            style="-fx-background-color: rgba(255, 255, 255, 0.75); -fx-background-radius: 20; -fx-border-color: rgba(255,255,255,0.5); -fx-border-width: 1.5; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.4), 20, 0, 0, 10);" 
            AnchorPane.rightAnchor="40.0" AnchorPane.topAnchor="60.0">
         <children>
            
            <Label text="LA PETITE CÔTE" textFill="#e67e22">
               <font><Font name="System Bold" size="26.0" /></font>
            </Label>
            
            <Label fx:id="lblError" alignment="CENTER" prefHeight="40.0" prefWidth="320.0" textAlignment="CENTER" textFill="#e74c3c" wrapText="true">
               <font><Font name="System Bold Italic" size="13.0" /></font>
            </Label>

            <StackPane pickOnBounds="false">
               <children>
                  
                  <VBox fx:id="vboxLogin" alignment="CENTER" spacing="20.0">
                     <children>
                        <TextField fx:id="emailLogin" prefHeight="45.0" promptText="Email professionnel" style="-fx-background-radius: 10;" />
                        <PasswordField fx:id="passwordLogin" prefHeight="45.0" promptText="Mot de passe" style="-fx-background-radius: 10;" />
                        <Button onAction="#handleLogin" prefHeight="45.0" prefWidth="280.0" 
                                style="-fx-background-color: #2c3e50; -fx-text-fill: white; -fx-background-radius: 25; -fx-font-weight: bold; -fx-cursor: hand;" text="SE CONNECTER" />
                        <Hyperlink onAction="#showRegisterForm" text="Pas encore de compte ? Créer un profil" textFill="#3498db" />
                     </children>
                  </VBox>

                  <VBox fx:id="vboxRegister" alignment="CENTER" managed="false" spacing="12.0" visible="false">
                     <children>
                        <HBox spacing="10.0">
                           <children>
                              <TextField fx:id="nomRegister" prefHeight="38.0" prefWidth="155.0" promptText="Nom" style="-fx-background-radius: 10;" />
                              <TextField fx:id="prenomRegister" prefHeight="38.0" prefWidth="155.0" promptText="Prénom" style="-fx-background-radius: 10;" />
                           </children>
                        </HBox>
                        <TextField fx:id="emailRegister" prefHeight="38.0" promptText="Email" style="-fx-background-radius: 10;" />
                        <PasswordField fx:id="passRegister" prefHeight="38.0" promptText="Mot de passe" style="-fx-background-radius: 10;" />
                        <TextField fx:id="phoneRegister" prefHeight="38.0" promptText="Téléphone (ex: 77...)" style="-fx-background-radius: 10;" />
                        <TextField fx:id="adresseRegister" prefHeight="38.0" promptText="Adresse complète" style="-fx-background-radius: 10;" />
                        <TextField fx:id="nationaliteRegister" prefHeight="38.0" promptText="Nationalité" style="-fx-background-radius: 10;" />
                        
                        <Button onAction="#handleRegister" prefHeight="45.0" prefWidth="280.0" 
                                style="-fx-background-color: #e67e22; -fx-text-fill: white; -fx-background-radius: 25; -fx-font-weight: bold; -fx-cursor: hand;" text="CRÉER MON COMPTE" />
                        <Hyperlink onAction="#showLoginForm" text="Déjà inscrit ? Me connecter" textFill="#3498db" />
                     </children>
                  </VBox>
                  
               </children>
            </StackPane>
         </children>
         <padding>
            <Insets bottom="35.0" left="30.0" right="30.0" top="35.0" />
         </padding>
      </VBox>
   </children>
</AnchorPane>