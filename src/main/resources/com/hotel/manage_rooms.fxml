<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox spacing="20.0" style="-fx-background-color: #f4f7f6;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.hotel.controller.ManageRoomController">

    <Label text="🏨 CONFIGURATION DES CHAMBRES" textFill="#2c3e50">
        <font><Font name="Segoe UI Bold" size="24.0" /></font>
    </Label>

    <VBox spacing="15.0" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5);">
        <children>
            <HBox alignment="CENTER_LEFT" spacing="15.0">
                <children>
                    <VBox spacing="5.0">
                        <Label text="Numéro" textFill="#7f8c8d"><font><Font size="12.0" /></font></Label>
                        <TextField fx:id="txtNumero" prefWidth="120.0" promptText="ex: 101" style="-fx-background-radius: 5;" />
                    </VBox>
                    
                    <VBox spacing="5.0">
                        <Label text="Type de Chambre" textFill="#7f8c8d"><font><Font size="12.0" /></font></Label>
                        <HBox alignment="CENTER_LEFT" spacing="5.0">
                            <children>
                                <ComboBox fx:id="comboType" prefWidth="250.0" promptText="Sélectionner..." style="-fx-background-radius: 5;" />
                                <Button onAction="#handleAddNewType" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-radius: 5;" text="+">
                                    <tooltip>
                                        <Tooltip text="Ajouter un nouveau type (Capacité/Prix)" />
                                    </tooltip>
                                </Button>
                            </children>
                        </HBox>
                    </VBox>

                    <VBox spacing="5.0">
                        <Label text="État actuel" textFill="#7f8c8d"><font><Font size="12.0" /></font></Label>
                        <ComboBox fx:id="comboEtat" prefWidth="150.0" promptText="État" style="-fx-background-radius: 5;" />
                    </VBox>
                </children>
            </HBox>

            <HBox alignment="CENTER_LEFT" spacing="12.0">
                <padding>
                    <Insets top="10.0" />
                </padding>
                <children>
                    <Button onAction="#handleAddRoom" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-min-width: 110; -fx-background-radius: 5;" text="➕ Ajouter" />
                    
                    <Button onAction="#handleUpdateRoom" style="-fx-background-color: #f39c12; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-min-width: 110; -fx-background-radius: 5;" text="📝 Modifier" />
                    
                    <Button onAction="#handleDeleteRoom" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-min-width: 110; -fx-background-radius: 5;" text="🗑️ Supprimer" />
                    
                    <Region HBox.hgrow="ALWAYS" /> 
                    
                    <Button onAction="#refreshTable" style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-cursor: hand; -fx-background-radius: 5;" text="🔄 Actualiser" />
                </children>
            </HBox>
        </children>
    </VBox>

    <TableView fx:id="roomTable" style="-fx-background-radius: 10; -fx-border-color: #dcdde1; -fx-border-radius: 10;" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colNumero" prefWidth="120.0" text="NUMÉRO" />
            <TableColumn fx:id="colType" prefWidth="300.0" text="TYPE / CAPACITÉ / TARIF" />
            <TableColumn fx:id="colEtat" prefWidth="180.0" text="ÉTAT" />
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
    </TableView>

    <padding>
        <Insets bottom="30" left="30" right="30" top="30" />
    </padding>
</VBox>