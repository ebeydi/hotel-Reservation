<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane fx:id="mainPane" prefHeight="700.0" prefWidth="1100.0"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.hotel.controller.HomeReceptionnisteController">

    <!-- Sidebar gauche -->
    <left>
        <VBox prefWidth="250.0" spacing="10.0" style="-fx-background-color: #2c3e50;">
            <padding>
                <Insets top="30.0" left="15.0" right="15.0" bottom="20.0"/>
            </padding>
            <children>
                <Label text="HÔTEL GESTION" textFill="#e67e22">
                    <font>
                        <Font name="System Bold" size="22.0"/>
                    </font>
                    <VBox.margin>
                        <Insets bottom="40.0"/>
                    </VBox.margin>
                </Label>

                <Button alignment="BASELINE_LEFT" maxWidth="Infinity" prefHeight="45.0"
                        text="🏠   Tableau de Bord" style="-fx-background-color: #34495e; -fx-text-fill: white; -fx-cursor: hand;"
                        onAction="#handleAccueil"/>

                <Button alignment="BASELINE_LEFT" maxWidth="Infinity" prefHeight="45.0"
                        text="📝   Nouvelle Réservation" style="-fx-background-color: transparent; -fx-text-fill: #ecf0f1; -fx-cursor: hand;"
                        onAction="#handlePasserReservation"/>

                <Button alignment="BASELINE_LEFT" maxWidth="Infinity" prefHeight="45.0"
                        text="🔑   Check-In" style="-fx-background-color: transparent; -fx-text-fill: #ecf0f1; -fx-cursor: hand;"
                        onAction="#handleCheckIn"/>

                <Button alignment="BASELINE_LEFT" maxWidth="Infinity" prefHeight="45.0"
                        text="🚪   Check-Out" style="-fx-background-color: transparent; -fx-text-fill: #ecf0f1; -fx-cursor: hand;"
                        onAction="#handleCheckOut"/>

                <Region VBox.vgrow="ALWAYS"/>

                <Button alignment="BASELINE_LEFT" maxWidth="Infinity" prefHeight="45.0"
                        text="🔒   Déconnexion" style="-fx-background-color: transparent; -fx-text-fill: #e74c3c; -fx-cursor: hand;"
                        onAction="#handleLogout"/>
            </children>
        </VBox>
    </left>

    <!-- Contenu principal -->
    <center>
        <VBox spacing="0.0" style="-fx-background-color: #f4f7f6;">
            <children>

                <!-- Header avec infos utilisateur -->
                <HBox alignment="CENTER_LEFT" prefHeight="80.0"
                      style="-fx-background-color: white; -fx-border-color: #dcdde1; -fx-border-width: 0 0 1 0;">
                    <padding>
                        <Insets left="30.0" right="30.0"/>
                    </padding>
                    <children>
                        <VBox alignment="CENTER_LEFT">
                            <children>
                                <Label fx:id="lblWelcome" text="Bienvenue, Chargement..." textFill="#2c3e50">
                                    <font>
                                        <Font name="System Bold" size="20.0"/>
                                    </font>
                                </Label>
                                <Label fx:id="lblEmail" text="" textFill="#7f8c8d"/>
                            </children>
                        </VBox>
                    </children>
                </HBox>

                <!-- Zone de contenu dynamique -->
                <StackPane fx:id="contentArea" VBox.vgrow="ALWAYS">
                    <padding>
                        <Insets top="10.0" left="10.0" right="10.0" bottom="10.0"/>
                    </padding>
                    <children>
                        <ProgressIndicator maxWidth="50" maxHeight="50"/>
                    </children>
                </StackPane>

            </children>
        </VBox>
    </center>
</BorderPane>