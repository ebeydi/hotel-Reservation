<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox spacing="15.0" style="-fx-background-color: white;" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.hotel.controller.AddStaffController">
   <children>
      <Label text="Nouveau Réceptionniste" textFill="#2c3e50">
         <font><Font name="System Bold" size="18.0" /></font>
      </Label>
      <Separator />
      
      <GridPane hgap="10.0" vgap="15.0">
        <columnConstraints>
          <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="120.0" />
          <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="200.0" />
        </columnConstraints>
        <rowConstraints>
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
        </rowConstraints>
         <children>
            <Label text="Nom :" />
            <TextField fx:id="txtNom" GridPane.columnIndex="1" />
            
            <Label text="Prénom :" GridPane.rowIndex="1" />
            <TextField fx:id="txtPrenom" GridPane.columnIndex="1" GridPane.rowIndex="1" />
            
            <Label text="Email :" GridPane.rowIndex="2" />
            <TextField fx:id="txtEmail" GridPane.columnIndex="1" GridPane.rowIndex="2" />

            <Label text="Nom d'utilisateur :" GridPane.rowIndex="3" />
            <TextField fx:id="txtLogin" GridPane.columnIndex="1" GridPane.rowIndex="3" />
            
            <Label text="Mot de passe :" GridPane.rowIndex="4" />
            <PasswordField fx:id="txtPass" GridPane.columnIndex="1" GridPane.rowIndex="4" />
         </children>
      </GridPane>
      
      <HBox alignment="CENTER_RIGHT" spacing="10.0">
         <children>
            <Button onAction="#handleCancel" style="-fx-background-color: #bdc3c7;" text="Annuler" />
            <Button onAction="#handleSave" style="-fx-background-color: #27ae60; -fx-text-fill: white;" text="Enregistrer" />
         </children>
         <VBox.margin><Insets top="10.0" /></VBox.margin>
      </HBox>
   </children>
   <padding>
      <Insets bottom="25.0" left="25.0" right="25.0" top="25.0" />
   </padding>
</VBox>